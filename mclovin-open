#!/bin/sh
# XDG handler shim for the mclovin Omarchy plugin.
#
# XDG requires an executable on disk to be the registered http/https handler,
# and the Omarchy shell is a process that is already running — it cannot be the
# Exec= target. This script is the smallest possible bridge: it hands the URL to
# the shell over IPC and gets out of the way. All routing logic lives in the
# plugin's Service.qml.
#
# If the shell is not reachable, the link must still open. A swallowed click is
# worse than the wrong browser, so this falls back to launching a browser
# directly rather than failing.

set -eu

config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-mclovin/config.json"

usage() {
  cat <<'USAGE'
mclovin — choose which browser opens a link.

Usage: mclovin-open [URL]
       mclovin-open --app=URL
       mclovin-open --incognito [URL]
       mclovin-open --fallback URL
       mclovin-open --zoom-direct URL

With no URL it opens the picker so you can just pick a browser. Registered as
the system http/https handler by the mclovin Omarchy plugin.
USAGE
}

# This stands in for a browser, so it is called the way a browser is, and that
# is not always with a URL. `omarchy-launch-browser` probes the default browser
# with `--help` to sniff out Firefox before launching it with no arguments at
# all. Treating either as a link put "--help" on the browser's command line,
# where it prints usage and exits — the reported "I pick a browser and nothing
# opens", for every browser rather than one.
url=""
want_private=0
zoom_direct=0
force_fallback=0

for argument in "$@"; do
  case $argument in
    --help|-h)
      usage
      exit 0
      ;;
    --app=*)
      # Handled below, where the webapp browser is resolved.
      url=$argument
      break
      ;;
    --fallback)
      # Service.qml uses this when a rule's own destination could not be run:
      # skip the IPC round trip -- the shell is what asked -- and open the link
      # in the fallback browser, which is the one thing this file guarantees.
      force_fallback=1
      ;;
    --zoom-direct)
      # Built-in rule target: the following URL is converted to zoommtg://
      # after the safe browser fallback helpers below have been defined.
      zoom_direct=1
      ;;
    # omarchy-launch-browser rewrites its own --private into whichever flag the
    # detected browser wants, so accept the whole family.
    --private|--incognito|--private-window|--inprivate)
      want_private=1
      ;;
    -*)
      # Some other browser flag. Not a link, so not a link.
      ;;
    *)
      [ -n "$url" ] || url=$argument
      ;;
  esac
done

setting() {
  [ -r "$config" ] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  value=$(jq -r "$1 // empty" "$config" 2>/dev/null) || return 1
  [ -n "$value" ] || return 1
  printf '%s' "$value"
}

# Find a .desktop by id and print the program its Exec= line starts with.
desktop_program() {
  id=$1
  case $id in
    *.desktop) ;;
    *) id="$id.desktop" ;;
  esac
  for dir in \
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
    /usr/local/share/applications \
    /usr/share/applications \
    /var/lib/flatpak/exports/share/applications
  do
    [ -f "$dir/$id" ] || continue
    sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$dir/$id" | head -n1
    return 0
  done
  return 1
}

# First installed browser that is not a mclovin router, as a desktop id.
#
# Every mclovin is skipped, not just this plugin's own entry. The retired CLI
# installs mclovin.desktop with Categories=Network;WebBrowser, so on a machine
# that ran both it is the only WebBrowser entry in ~/.local/share/applications
# — which is scanned first. Skipping only this plugin's reverse-DNS id handed
# every fallback click to the old router, with its own separate rules.toml and
# its own picker, and the real browsers in /usr/share/applications were never
# reached.
first_browser() {
  # The same four directories launch_desktop and desktop_program search. Two of
  # them were missing here, so a browser installed only as a Flatpak, or only
  # under /usr/local, was reported as "no browser found" by the one function
  # whose answer decides whether the notification fires.
  for dir in \
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
    /usr/local/share/applications \
    /usr/share/applications \
    /var/lib/flatpak/exports/share/applications
  do
    [ -d "$dir" ] || continue
    for file in "$dir"/*.desktop; do
      [ -f "$file" ] || continue
      case $(basename "$file") in
        *mclovin*) continue ;;
      esac
      grep -qi '^Categories=.*WebBrowser' "$file" || continue

      # An uninstalled browser leaves its .desktop behind, and this is the last
      # candidate before the notification -- returning it hands the click to a
      # program that is not there and calls that success.
      #
      # The quote strip is not cosmetic. A real entry on the machine this was
      # written on reads `Exec="/home/…/bin/claude" …`, whose first whitespace
      # token carries a literal quote and resolves to nothing without it.
      program=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$file" | head -n1)
      program=${program#\"}
      program=${program%\"}
      [ -n "$program" ] || continue
      command -v "$program" >/dev/null 2>&1 || continue

      basename "$file"
      return 0
    done
  done
  return 1
}

# The flag that pins a profile, by family. Chromium takes a directory name and
# Gecko takes either a name or an absolute path.
#
# The value is used as written. Service.qml resolves a profile's display name to
# its on-disk directory by reading the browser's own Local State, which needs
# the profile store this script has no business parsing -- and resolveProfileDirectory
# falls back to treating the value as a directory anyway, which is what someone
# editing config.json by hand is most likely to have typed.
profile_args() {
  case $(printf '%s %s' "$1" "${2:-}" | tr '[:upper:]' '[:lower:]') in
    *firefox*|*librewolf*|*zen*|*floorp*|*waterfox*|*icecat*|*mullvad*)
      case $3 in
        /*) printf '%s\n%s' '--profile' "$3" ;;
        *)  printf '%s\n%s' '-P' "$3" ;;
      esac
      ;;
    *) printf '%s' "--profile-directory=$3" ;;
  esac
}

# The flag each family's own [Desktop Action new-private-window] runs -- the
# same table as Browsers.js privateFlag, and it is a table rather than a guess
# for the same reason: every entry was read off an installed .desktop.
#
# A family with no entry gets nothing and the caller refuses, because opening an
# ordinary window and calling it private is the failure this exists to prevent.
# Matched on the desktop id AND the resolved program, since ids like
# io.gitlab.librewolf-community do not all name the family they belong to.
private_flag() {
  case $(printf '%s %s' "$1" "${2:-}" | tr '[:upper:]' '[:lower:]') in
    *firefox*|*librewolf*|*zen*|*floorp*|*waterfox*|*icecat*|*mullvad*) printf '%s' '--private-window' ;;
    *brave*|*chrom*|*edge*|*vivaldi*|*opera*|*helium*|*thorium*) printf '%s' '--incognito' ;;
    *) return 1 ;;
  esac
}

# Locate a .desktop by id across the standard data dirs and run its Exec line
# with the URL substituted. Used only on the fallback path.
#
# The URL arrives from whatever asked the system to open a link, so it is
# untrusted input and never becomes shell source. This builds an argument list
# and runs it directly: the link is one element of that list, so a URL
# containing $(…), a backtick or a quote is a strange URL and nothing more.
# Substituting it into a command string for `sh -c` — even with the quotes
# escaped — makes any of those execute as the user instead.
launch_desktop() {
  id=$1
  case $id in
    *.desktop) ;;
    *) id="$id.desktop" ;;
  esac

  for dir in \
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
    /usr/local/share/applications \
    /usr/share/applications \
    /var/lib/flatpak/exports/share/applications
  do
    file="$dir/$id"
    [ -f "$file" ] || continue

    # First Exec= in the [Desktop Entry] group.
    exec_line=$(sed -n 's/^Exec=//p' "$file" | head -n1)
    [ -n "$exec_line" ] || continue

    # Split the Exec line on whitespace, with globbing off so a token holding a
    # * cannot expand into a list of filenames. Quoted arguments containing
    # spaces are not reassembled — no installed browser writes one, and the
    # plugin's own launcher, which handles the ordinary path, parses them
    # properly. Splitting wrongly here fails to launch; it cannot run anything
    # that was not already in the desktop file.
    set -f
    # shellcheck disable=SC2086
    set -- $exec_line
    set +f
    [ "$#" -gt 0 ] || continue

    # `setsid ... &` below cannot report a failed exec: the shell forks, the
    # child dies with 127 into a discarded stream, and this function has already
    # returned 0. A stale entry from an uninstalled browser therefore swallowed
    # the link in silence, and fallback_url never reached first_browser because
    # it had been told the launch worked.
    #
    # `continue` rather than `return 1`: the same id is retried in the next data
    # dir, so a shadowed local entry falls through to the packaged one.
    command -v "$1" >/dev/null 2>&1 || continue

    # Rebuild the list, replacing the URL field codes with the link and dropping
    # every other code, as the desktop entry spec requires. Rotating the
    # positional parameters is the only array a POSIX shell has: each turn takes
    # one original off the front and appends what it becomes to the back.
    count=$#
    url_seen=0
    i=0
    while [ "$i" -lt "$count" ]; do
      token=$1
      shift
      case $token in
        %u|%U|%f|%F)
          url_seen=1
          [ -z "$url" ] || set -- "$@" "$url"
          ;;
        %[a-zA-Z]) ;;
        *) set -- "$@" "$token" ;;
      esac
      i=$((i + 1))
    done

    # An entry with no placeholder still has to receive the link, which is what
    # the plugin's launcher and the mclovin CLI both do.
    if [ "$url_seen" -eq 0 ] && [ -n "$url" ]; then
      set -- "$@" "$url"
    fi
    [ "$#" -gt 0 ] || continue

    # Service.qml refuses to send a private request to the fallback browser and
    # opens the picker instead, because a fallback launched with no private flag
    # records exactly the history the request existed to avoid. With the shell
    # down there is no picker to fall through to, so the flag is added here
    # rather than dropped -- and where the family has none, the click is refused
    # and said so, which is the only honest answer left.
    #
    # The flag goes right after the program, before the entry's own arguments:
    # Chromium hands a URL to an already-running process and only honours flags
    # that precede it.
    # Service.qml pins fallbackProfile on its own fallback; ignoring it here put
    # the same link in a different profile depending on whether the shell
    # happened to be up.
    if profile=$(setting '.fallbackProfile'); then
      program=$1
      shift
      # Flags precede the entry's own arguments: Chromium hands a URL to an
      # already-running process and only honours what comes before it.
      # A literal newline, not $(printf '\n'): command substitution strips
      # trailing newlines, so IFS would come out empty and `-P Personal` would
      # reach the browser as one argument with a newline inside it.
      old_ifs=$IFS
      IFS='
'
      set -f
      # shellcheck disable=SC2046
      set -- "$program" $(profile_args "$id" "$program" "$profile") "$@"
      set +f
      IFS=$old_ifs
    fi

    if [ "$want_private" -eq 1 ]; then
      if private=$(private_flag "$id" "$1"); then
        program=$1
        shift
        set -- "$program" "$private" "$@"
      else
        if command -v notify-send >/dev/null 2>&1; then
          notify-send -u critical "mclovin" \
            "$id has no private-window flag, so this link was not opened. Opening it normally would have recorded the history you asked it not to." || true
        fi
        return 1
      fi
    fi

    setsid "$@" >/dev/null 2>&1 &
    return 0
  done

  return 1
}

# Open a URL in a real browser without asking the system's http handler. Once
# mclovin is the default, xdg-open on the original URL would route straight
# back here and loop; resolving the configured desktop entry avoids that.
fallback_url() {
  # POSIX sh has no `local`, so this writes the global — deliberately.
  # launch_desktop substitutes $url into the Exec line it runs, and reads it
  # from here. Passing a URL that is not the one already in $url is therefore
  # not a spelling difference; it is the only way to make launch_desktop open
  # something other than what was asked for.
  url=$1

  if fallback=$(setting '.fallback') && launch_desktop "$fallback"; then
    return 0
  fi

  if any=$(first_browser) && launch_desktop "$any"; then
    return 0
  fi

  if command -v notify-send >/dev/null 2>&1; then
    notify-send -u critical "mclovin" "Could not open $url — no fallback browser is available."
  fi
  return 1
}

# Convert only numbered HTTPS meeting URLs on zoom.us or its subdomains. The
# password stays percent-encoded exactly as Zoom supplied it; xdg-open receives
# the resulting URI as one argument, never as shell source.
zoom_join_uri() {
  original=$1
  case $original in
    *://*)
      scheme=${original%%://*}
      scheme=$(printf '%s' "$scheme" | tr '[:upper:]' '[:lower:]')
      [ "$scheme" = "https" ] || return 1
      rest=${original#*://}
      ;;
    *) return 1 ;;
  esac

  authority=${rest%%/*}
  [ "$authority" != "$rest" ] || return 1
  case $authority in *'@'*) return 1 ;; esac

  host=${authority%%:*}
  host=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')
  case $host in
    zoom.us|*.zoom.us) ;;
    *) return 1 ;;
  esac

  path_and_query=/${rest#*/}
  path=${path_and_query%%\?*}
  path=${path%%\#*}
  case $path in
    /j/*) meeting=${path#/j/} ;;
    /w/*) meeting=${path#/w/} ;;
    /wc/join/*) meeting=${path#/wc/join/} ;;
    *) return 1 ;;
  esac
  meeting=${meeting%%/*}
  case $meeting in ''|*[!0-9-]*) return 1 ;; esac
  confno=$(printf '%s' "$meeting" | tr -d '-')
  [ -n "$confno" ] || return 1

  password=""
  case $path_and_query in
    *\?*)
      query=${path_and_query#*\?}
      query=${query%%\#*}
      while [ -n "$query" ]; do
        pair=${query%%&*}
        if [ "$pair" = "$query" ]; then query=""; else query=${query#*&}; fi
        key=${pair%%=*}
        if [ "$key" = "pwd" ]; then
          [ "$pair" = "$key" ] || password=${pair#*=}
          break
        fi
      done
      ;;
  esac

  uri="zoommtg://zoom.us/join?action=join&confno=$confno"
  [ -z "$password" ] || uri="$uri&pwd=$password"
  printf '%s\n' "$uri"
}

# --app= is a Chromium flag. Gecko has no equivalent: handed one, Firefox starts
# on its own home page and never loads the URL at all. Service.qml refuses the
# same target on the IPC path with the same reasoning; this branch runs before
# the omarchy-shell call and never reaches that code.
#
# Written as "is this Gecko" rather than "is this Chromium" on purpose. An
# allow-list of chrome|brave|edge|vivaldi silently excludes opera, helium,
# thorium and every other fork -- all of which do have --app, and two of which
# are on upstream's own whitelist in omarchy-launch-webapp. Naming the family
# that cannot is a short list that stays short.
gecko_browser() {
  case $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]') in
    *firefox*|*librewolf*|*zen*|*floorp*|*waterfox*|*icecat*|*seamonkey*|*mullvad*) return 0 ;;
    *) return 1 ;;
  esac
}

# `omarchy-launch-webapp` invokes the default browser as `<browser> --app=URL`.
# That is a chromeless window for one site, not a link to route, so it never
# reaches the picker -- it goes straight to the configured webapp browser.
case $url in
  --app=*)
    app_url=${url#--app=}

    # Each candidate has to survive being resolved, not merely being set.
    # `target=$(setting .webapp) || target=$(setting .fallback)` short-circuited
    # on the first successful READ, so a .webapp naming a browser that had since
    # been uninstalled read fine and the fallback was never consulted --
    # Service.qml walks the same three candidates and skips the ones it cannot
    # resolve, which is why the shell opened the web app and the shim did not.
    app_candidate=""
    for source in webapp fallback any; do
      case $source in
        webapp)   candidate=$(setting '.webapp')   || candidate="" ;;
        fallback) candidate=$(setting '.fallback') || candidate="" ;;
        any)      candidate=$(first_browser)       || candidate="" ;;
      esac
      [ -n "$candidate" ] || continue

      if gecko_browser "$candidate"; then
        # An explicitly configured Gecko browser is a mistake worth naming, not
        # one to paper over by quietly using a different browser. Say the same
        # thing Service.qml says, then keep looking.
        if [ "$source" = webapp ] && command -v notify-send >/dev/null 2>&1; then
          notify-send -u critical "mclovin" \
            "$candidate has no --app window. Set \"webapp\" in $config to a Chromium-family browser." || true
        fi
        continue
      fi

      candidate_program=$(desktop_program "$candidate") || continue
      [ -n "$candidate_program" ] || continue
      command -v "$candidate_program" >/dev/null 2>&1 || continue
      app_candidate=$candidate
      break
    done

    # Launch through launch_desktop with `--app=URL` standing in for the link,
    # rather than running the entry's first Exec token with the flag bolted on.
    #
    # desktop_program keeps only that first token, so a Flatpak-exported browser
    # -- whose Exec is `/usr/bin/flatpak run --branch=… --command=brave
    # com.brave.Browser @@u %U @@` -- was launched as `flatpak --app=URL`, which
    # is not a flatpak flag and opens nothing. The flatpak export directory is
    # deliberately searched, so this was reachable.
    #
    # `--app=URL` is the browser argument that replaces the URL, so putting it
    # where %u/%U sits puts it exactly where the browser's own arguments begin,
    # wrapper or no wrapper. launch_desktop already does that substitution, and
    # searches all four data directories while it is at it.
    if [ -n "$app_candidate" ]; then
      url="--app=$app_url"
      launch_desktop "$app_candidate" && exit 0
    fi

    # Nothing can open a chromeless window. The header of this file rules out
    # swallowing the click, so the web app opens as an ordinary tab instead --
    # with chrome around it rather than not at all. fallback_url notifies when
    # even that fails.
    fallback_url "$app_url"
    exit $?
    ;;
esac

# Whether anything on this machine claims zoommtg:// links.
#
# Asked outright, because xdg-open's exit status cannot answer it: with nothing
# registered for a scheme it searches every mimeapps location, opens nothing and
# still exits 0. Measured with XDG_UTILS_DEBUG_LEVEL=2. Trusting that status
# meant `&& exit 0` fired on a machine without Zoom and the meeting link was
# dropped in silence — no browser, no notification — which is the one thing the
# header of this file promises never happens.
#
# xdg-mime and xdg-open ship together in xdg-utils, so requiring both costs
# nothing that was going to work anyway.
zoom_handler_exists() {
  command -v xdg-mime >/dev/null 2>&1 || return 1
  handler=$(xdg-mime query default x-scheme-handler/zoommtg 2>/dev/null) || return 1
  [ -n "$handler" ]
}

if [ "$zoom_direct" -eq 1 ]; then
  if uri=$(zoom_join_uri "$url") && command -v xdg-open >/dev/null 2>&1 \
     && zoom_handler_exists; then
    xdg-open "$uri" >/dev/null 2>&1 && exit 0
  fi
  fallback_url "$url"
  exit $?
fi

if [ "$force_fallback" -eq 1 ]; then
  [ -n "$url" ] || exit 1
  fallback_url "$url"
  exit $?
fi

# The happy path. omarchy-shell reports IPC-level failures on stdout with exit
# 0, so the reply is checked rather than the exit status: Service.qml answers
# with one of routed/asked/failed/empty.
if command -v omarchy-shell >/dev/null 2>&1; then
  if [ "$want_private" -eq 1 ]; then
    reply=$(omarchy-shell io.github.guilhermeyo.mclovin openPrivate "$url" 2>/dev/null || true)
  else
    reply=$(omarchy-shell io.github.guilhermeyo.mclovin open "$url" 2>/dev/null || true)
  fi
  case $reply in
    routed|asked) exit 0 ;;
  esac
fi

# Nothing to fall back to when there was no link in the first place: the ask was
# "let me pick a browser", and without the shell there is no picker to offer.
[ -n "$url" ] || exit 1

# Shell down, plugin disabled, or the picker could not be summoned. A link is
# never dropped just because the shell is not answering.
fallback_url "$url"

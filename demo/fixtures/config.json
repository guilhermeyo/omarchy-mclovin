{
  "version": 1,
  "fallback": "",
  "webapp": "",
  "rules": [
    {
      "when": "startsWith",
      "terms": [
        "https://mail."
      ],
      "browser": "google-chrome",
      "profile": "Design"
    },
    {
      "when": "contains",
      "terms": [
        "docs.google.com",
        "drive.google.com"
      ],
      "browser": "chromium",
      "profile": "Work"
    },
    {
      "when": "contains",
      "terms": [
        "invoice"
      ],
      "browser": "chromium",
      "profile": "Work",
      "private": true
    },
    {
      "when": "host",
      "terms": [
        "hedge.example"
      ],
      "browser": "firefox",
      "profile": "Personal",
      "private": true
    }
  ]
}
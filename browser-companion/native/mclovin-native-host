#!/usr/bin/env python3
"""Chromium native-messaging bridge for mclovin.

A link clicked inside a browser never reaches an XDG handler -- the browser owns
that navigation. This is the way over that ceiling: the extension catches the
click in the page and hands the URL here, and here hands it to mclovin, which
applies the same rules it applies to every other link on the system.
"""

from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import struct
import subprocess
import sys
from urllib.parse import urlsplit


EXTENSION_ID = "nplmoglnnfadaifhkpkmimcbgmfakfec"
ALLOWED_ORIGIN = f"chrome-extension://{EXTENSION_ID}/"
MAX_MESSAGE_BYTES = 64 * 1024
MEETING_PATH = re.compile(r"^/(?:j|w)/[0-9][0-9-]*/?$|^/wc/join/[0-9][0-9-]*/?$")

# Rules the companion is allowed to act on: the ones whose destination leaves
# the browser. A rule naming a browser is deliberately excluded -- clicking a
# link that is already going to the browser you are reading in should navigate
# the tab, not open a second one, and only the browser can do that.
INTERCEPTABLE = ("webapp", "action", "command")
MAX_RULES = 200


def state_path():
    state_home = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return state_home / "omarchy-mclovin" / "browser-companion.json"


# Router.WHEN_* -- the four matcher kinds, and the only action it defines.
WHEN_KINDS = ("startsWith", "contains", "host", "regex")
# Router.js: the destination that means "the desktop application that owns this
# site". `zoom` is what it was called when Zoom was the only site it knew, and
# Router still reads it, so both are known here -- a rule Router routes and this
# file skips is a rule the panel says it is watching and the extension is not.
ACTIONS = ("native", "zoom")


def term_list(value):
    """Router.termList: a scalar counts as one term, and terms are trimmed.

    Not iterating a bare string is the whole point. `terms: "whatsapp.com"` is
    one term to Router; iterating it here would serve twelve one-character
    `contains` matchers, and a one-character `contains` matches nearly every URL
    on every page.
    """
    items = value if isinstance(value, (list, tuple)) else [value]
    return [t.strip() for t in items if isinstance(t, str) and t.strip()]


def normalized_matcher(rule):
    """The {when, terms} Router would route by, or None.

    config.json on disk is whatever was last written there, and Router migrates
    the pre-form shape -- `matchRegex` for a regex, `match` for a plain term --
    every time it loads. Nothing rewrites the file until a rule is edited
    through the form, so a config that predates the form, or one edited by hand
    from the README's own examples, still carries it.

    Reading the file raw made those rules invisible to the companion while the
    panel, reading the same file through Router, said it was watching them.
    """
    when = str(rule.get("when") or "").strip()
    terms = term_list(rule.get("terms"))

    if when not in WHEN_KINDS:
        regex = str(rule.get("matchRegex") or "").strip()
        if regex:
            when, terms = "regex", [regex]
        else:
            when = "contains"
            if not terms:
                terms = term_list(rule.get("match"))

    return {"when": when, "terms": terms} if terms else None


def config_path():
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "omarchy-mclovin" / "config.json"


def interceptable_rules():
    """The matchers the extension should watch for, and nothing else.

    Only `when` and `terms` travel. The destination stays here: the extension
    has no business knowing which browser or web app a link ends up in, and
    sending it would put routing decisions in two places.
    """
    try:
        config = json.loads(config_path().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, ValueError):
        return []
    if not isinstance(config, dict):
        return []

    out = []
    for rule in (config.get("rules") or [])[:MAX_RULES]:
        if not isinstance(rule, dict):
            continue
        if str(rule.get("action") or "").strip() not in ("",) + ACTIONS:
            # Router drops a rule whose action it does not know, so watching for
            # one would cancel clicks that then reach a rule that does not exist.
            continue
        if not any(str(rule.get(kind) or "").strip() for kind in INTERCEPTABLE):
            continue
        matcher = normalized_matcher(rule)
        if matcher:
            out.append(matcher)
    return out


def routable_url(value):
    """An ordinary web link, or "".

    Deliberately not a rule check -- mclovin decides where a link goes, and
    asking twice is how the two answers start disagreeing. This only refuses
    what should never reach a router at all: a scheme that is not http(s), and
    anything long enough to be an attack rather than a link.
    """
    if not isinstance(value, str) or len(value) > 8192:
        return ""
    try:
        parsed = urlsplit(value)
    except ValueError:
        return ""
    if parsed.scheme not in ("http", "https"):
        return ""
    if not parsed.hostname:
        return ""
    return value


def zoom_meeting_url(value):
    if not isinstance(value, str) or len(value) > 8192:
        return ""
    try:
        parsed = urlsplit(value)
        hostname = (parsed.hostname or "").lower()
        port = parsed.port
    except ValueError:
        return ""
    if parsed.scheme != "https":
        return ""
    if hostname != "zoom.us" and not hostname.endswith(".zoom.us"):
        return ""
    if parsed.username or parsed.password or port not in (None, 443):
        return ""
    if not MEETING_PATH.fullmatch(parsed.path):
        return ""
    return value


def read_message(stream):
    header = stream.read(4)
    if len(header) != 4:
        raise ValueError("missing message header")
    size = struct.unpack("=I", header)[0]
    if size > MAX_MESSAGE_BYTES:
        raise ValueError("message is too large")
    payload = stream.read(size)
    if len(payload) != size:
        raise ValueError("incomplete message")
    return json.loads(payload.decode("utf-8"))


def write_message(stream, message):
    payload = json.dumps(message, separators=(",", ":")).encode("utf-8")
    stream.write(struct.pack("=I", len(payload)))
    stream.write(payload)
    stream.flush()


def record_connected(request):
    version = request.get("version", "")
    if not isinstance(version, str) or len(version) > 64:
        version = ""
    destination = state_path()
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_suffix(".json.new")
    state = {
        "version": 1,
        "extensionId": EXTENSION_ID,
        "extensionVersion": version,
        "lastSeen": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
    }
    temporary.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    temporary.replace(destination)
    return state


def run_helper(arguments):
    helper = Path(__file__).resolve().parents[2] / "mclovin-open"
    if not helper.is_file() or not os.access(helper, os.X_OK):
        return False, "mclovin-open is missing or not executable"
    try:
        result = subprocess.run(
            [str(helper)] + arguments,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=20,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return False, str(error)
    return (True, "") if result.returncode == 0 else (False, "mclovin-open failed")


def open_zoom(url):
    return run_helper(["--zoom-direct", url])


def open_url(url):
    # No --zoom-direct here: this is an ordinary link, and mclovin-open routes it
    # through the same rules every other link on the system goes through. A rule
    # that resolves to the Zoom action reaches --zoom-direct from the other side,
    # where the URL is validated again before it becomes a zoommtg:// URI.
    return run_helper([url])


def handle_request(request):
    if not isinstance(request, dict):
        raise ValueError("message must be an object")
    message_type = request.get("type", "openZoomDirectly")
    if message_type == "status":
        state = record_connected(request)
        return {"ok": True, "extensionId": EXTENSION_ID, "lastSeen": state["lastSeen"],
                "rules": interceptable_rules()}
    if message_type == "rules":
        return {"ok": True, "rules": interceptable_rules()}

    if message_type == "openZoomDirectly":
        url = zoom_meeting_url(request.get("url"))
        if not url:
            raise ValueError("not a Zoom meeting URL")
        opener = open_zoom
    elif message_type == "openUrl":
        url = routable_url(request.get("url"))
        if not url:
            raise ValueError("not a routable link")
        opener = open_url
    else:
        raise ValueError("unknown message type")

    try:
        record_connected(request)
    except OSError:
        # Status is useful but never allowed to block a launch.
        pass
    ok, error = opener(url)
    response = {"ok": ok}
    if error:
        response["error"] = error
    return response


def main():
    try:
        if len(sys.argv) < 2 or sys.argv[1] != ALLOWED_ORIGIN:
            raise ValueError("caller is not the mclovin extension")
        response = handle_request(read_message(sys.stdin.buffer))
    except (OSError, ValueError, json.JSONDecodeError) as error:
        response = {"ok": False, "error": str(error)}

    write_message(sys.stdout.buffer, response)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

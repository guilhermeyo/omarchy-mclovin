#!/usr/bin/env python3
"""Install, remove, inspect, or open mclovin's Chromium companion setup."""

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess


HOST = "io.github.guilhermeyo.mclovin"

# The host was named for Zoom when Zoom was the only thing it opened. An install
# clears the old registration so a browser is never left holding two manifests,
# one of them pointing at a message type this host no longer answers.
LEGACY_HOSTS = ("io.github.guilhermeyo.mclovin.zoom",)
EXTENSION_ID = "nplmoglnnfadaifhkpkmimcbgmfakfec"
STORE_URL = ""
# `flags` is the file the browser reads its command line from at startup, under
# ~/.config. Chromium-family launchers on Linux read one -- Brave and Chrome
# through a shell wrapper, Arch's chromium inside the binary itself -- and it is
# how Omarchy installs its own extensions. A browser with no entry here is still
# fully supported; its extension is loaded by hand instead.
BROWSERS = {
    "chromium": {
        "config": "chromium",
        "programs": ["chromium"],
        "flags": "chromium-flags.conf",
    },
    "chrome": {
        "config": "google-chrome",
        "programs": ["google-chrome-stable", "google-chrome"],
        "flags": "chrome-flags.conf",
    },
    "chrome-testing": {
        "config": "google-chrome-for-testing",
        "programs": ["google-chrome-for-testing"],
        "flags": "",
    },
    "brave": {
        "config": "BraveSoftware/Brave-Browser",
        "programs": ["brave", "brave-browser"],
        "flags": "brave-flags.conf",
    },
    "vivaldi": {
        "config": "vivaldi",
        "programs": ["vivaldi-stable", "vivaldi"],
        "flags": "vivaldi-flags.conf",
    },
    "edge": {
        "config": "microsoft-edge",
        "programs": ["microsoft-edge-stable", "microsoft-edge"],
        "flags": "microsoft-edge-flags.conf",
    },
}

FLAG = "--load-extension="


def config_home():
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def state_path():
    state_home = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return state_home / "omarchy-mclovin" / "browser-companion.json"


def native_host():
    return (Path(__file__).resolve().parent / "mclovin-native-host").resolve()


def extension_path():
    return (Path(__file__).resolve().parent.parent / "extension").resolve()


def flags_path(browser):
    name = BROWSERS[browser].get("flags") or ""
    return config_home() / name if name else None


def read_flags(browser):
    path = flags_path(browser)
    if not path or not path.is_file():
        return None
    try:
        return path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return None


def write_flags(browser, lines):
    path = flags_path(browser)
    temporary = path.with_suffix(path.suffix + ".new")
    temporary.write_text("\n".join(lines) + "\n", encoding="utf-8")
    temporary.replace(path)


def extension_loaded(browser):
    """Whether this browser is set to load the extension at startup."""
    wanted = str(extension_path())
    for line in read_flags(browser) or []:
        if line.startswith(FLAG) and wanted in line.split("=", 1)[1].split(","):
            return True
    return False


def load_extension(browser):
    """Add the extension to the browser's own --load-extension list.

    The same mechanism Omarchy uses for its own extensions, and the reason this
    needs neither a Chrome Web Store listing nor Developer mode: an extension
    named on the command line is installed as COMMAND_LINE rather than unpacked,
    so Chromium does not nag about it on every start.

    Appending to the existing list rather than replacing it matters -- Omarchy
    puts its own extensions on that same line, and a rewrite would silently
    uninstall them.
    """
    path = flags_path(browser)
    if not path:
        return False
    lines = read_flags(browser)
    if lines is None:
        lines = []
    if extension_loaded(browser):
        return False

    wanted = str(extension_path())
    for index, line in enumerate(lines):
        if line.startswith(FLAG):
            lines[index] = line.rstrip(",") + "," + wanted
            break
    else:
        lines.append(FLAG + wanted)

    path.parent.mkdir(parents=True, exist_ok=True)
    write_flags(browser, lines)
    return True


def unload_extension(browser):
    """Take only our own path back out, leaving every other extension alone."""
    lines = read_flags(browser)
    if lines is None:
        return False

    wanted = str(extension_path())
    changed = False
    out = []
    for line in lines:
        if not line.startswith(FLAG):
            out.append(line)
            continue
        kept = [p for p in line.split("=", 1)[1].split(",") if p and p != wanted]
        if len(kept) != len(line.split("=", 1)[1].split(",")):
            changed = True
        # A flags file with an empty --load-extension= is a browser that refuses
        # to start, so the whole line goes when nothing is left on it.
        if kept:
            out.append(FLAG + ",".join(kept))

    if changed:
        write_flags(browser, out)
    return changed


def manifest_path(browser, host=HOST):
    return config_home() / BROWSERS[browser]["config"] / "NativeMessagingHosts" / f"{host}.json"


def drop_legacy(browser):
    for host in LEGACY_HOSTS:
        stale = manifest_path(browser, host)
        if stale.is_file():
            stale.unlink()


def existing_browsers(include_registered=False):
    found = []
    for name, details in BROWSERS.items():
        profile_exists = (config_home() / details["config"]).is_dir()
        if profile_exists or (include_registered and manifest_path(name).is_file()):
            found.append(name)
    return found


def selected_browsers(names, include_registered=False):
    selected = names or existing_browsers(include_registered)
    if not selected:
        raise ValueError("no supported browser profile found; name a browser explicitly")
    return selected


def host_manifest():
    host = native_host()
    if not host.is_file() or not os.access(host, os.X_OK):
        raise ValueError(f"native host is missing or not executable: {host}")
    return {
        "name": HOST,
        "description": "Open Zoom meeting links through mclovin",
        "path": str(host),
        "type": "stdio",
        "allowed_origins": [f"chrome-extension://{EXTENSION_ID}/"],
    }


def write_json(destination, value):
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_suffix(destination.suffix + ".new")
    temporary.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
    temporary.replace(destination)


def install(names):
    selected = selected_browsers(names)
    manifest = host_manifest()
    for browser in selected:
        write_json(manifest_path(browser), manifest)
        drop_legacy(browser)
        load_extension(browser)
    return selected


def uninstall(names):
    selected = selected_browsers(names, include_registered=True)
    removed = []
    for browser in selected:
        destination = manifest_path(browser)
        drop_legacy(browser)
        unload_extension(browser)
        if destination.is_file():
            destination.unlink()
            removed.append(browser)
    if not any(manifest_path(name).is_file() for name in BROWSERS):
        connection = state_path()
        if connection.is_file():
            connection.unlink()
    return removed


def read_json(path):
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def status():
    expected = host_manifest()
    registered = []
    invalid = []
    for name in BROWSERS:
        destination = manifest_path(name)
        if not destination.is_file():
            continue
        if read_json(destination) == expected:
            registered.append(name)
        else:
            invalid.append(name)

    connection = read_json(state_path())
    connected = bool(
        registered
        and connection.get("extensionId") == EXTENSION_ID
        and connection.get("lastSeen")
    )
    return {
        "extensionId": EXTENSION_ID,
        "extensionPath": str(extension_path()),
        "registeredBrowsers": registered,
        "loadingBrowsers": [name for name in BROWSERS if extension_loaded(name)],
        "invalidBrowsers": invalid,
        "connected": connected,
        "extensionVersion": connection.get("extensionVersion", "") if connected else "",
        "lastSeen": connection.get("lastSeen", "") if connected else "",
        "storeUrl": STORE_URL,
    }


def browser_program(preferred=""):
    order = [preferred] if preferred else existing_browsers(include_registered=True)
    order += [name for name in BROWSERS if name not in order]
    for name in order:
        if name not in BROWSERS:
            continue
        for candidate in BROWSERS[name]["programs"]:
            program = shutil.which(candidate)
            if program:
                return name, program
    raise ValueError("no supported Chromium-family browser executable found")


def open_setup(preferred=""):
    browser, program = browser_program(preferred)
    url = STORE_URL or "chrome://extensions/"
    subprocess.Popen(
        [program, url],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    return {"browser": browser, "url": url, "extensionPath": str(extension_path())}


def output(value, as_json):
    if as_json:
        print(json.dumps(value, separators=(",", ":")))
    elif isinstance(value, list):
        for item in value:
            print(item)
    else:
        print(json.dumps(value, indent=2))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    for command in ("install", "uninstall"):
        subparser = subparsers.add_parser(command)
        subparser.add_argument("browsers", nargs="*", choices=sorted(BROWSERS))
        subparser.add_argument("--json", action="store_true")

    status_parser = subparsers.add_parser("status")
    status_parser.add_argument("--json", action="store_true")

    open_parser = subparsers.add_parser("open")
    open_parser.add_argument("--browser", choices=sorted(BROWSERS), default="")
    open_parser.add_argument("--json", action="store_true")

    setup_parser = subparsers.add_parser("setup")
    setup_parser.add_argument("browsers", nargs="*", choices=sorted(BROWSERS))
    setup_parser.add_argument("--browser", choices=sorted(BROWSERS), default="")
    setup_parser.add_argument("--json", action="store_true")

    args = parser.parse_args()
    try:
        if args.command == "install":
            result = {"installed": install(args.browsers), **status()}
        elif args.command == "uninstall":
            result = {"removed": uninstall(args.browsers), **status()}
        elif args.command == "open":
            result = open_setup(args.browser)
        elif args.command == "setup":
            installed = install(args.browsers)
            result = {"installed": installed, **open_setup(args.browser), **status()}
        else:
            result = status()
    except (OSError, ValueError) as error:
        parser.error(str(error))

    output(result, args.json)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
